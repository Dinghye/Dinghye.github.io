<div class="repo-heatmap p-2 w-100 text-center">
  <a href="https://github.com/{{ include.username }}">
    <img
      class="only-light w-100"
      alt="{{ include.username }} GitHub contribution graph"
      src="https://ghchart.rshah.org/216e39/{{ include.username }}"
    >
    <img
      class="only-dark w-100"
      alt="{{ include.username }} GitHub contribution graph"
      src="https://ghchart.rshah.org/2ea043/{{ include.username }}"
    >
  </a>
</div>
