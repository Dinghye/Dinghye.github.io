<div class="repo p-2 text-center">
  <a href="https://github.com/{{ include.username }}">
    <img
      class="only-light w-100"
      alt="{{ include.username }} GitHub streak"
      src="https://streak-stats.demolab.com/?user={{ include.username }}&theme={{ site.repo_theme_light }}&hide_border=false&disable_animations=true"
    >
    <img
      class="only-dark w-100"
      alt="{{ include.username }} GitHub streak"
      src="https://streak-stats.demolab.com/?user={{ include.username }}&theme={{ site.repo_theme_dark }}&hide_border=false&disable_animations=true"
    >
  </a>
</div>
